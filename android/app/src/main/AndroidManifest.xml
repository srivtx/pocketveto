<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- The web layer is bundled locally; the virtual https origin still
         requires INTERNET for WebView bookkeeping. No telemetry, no other
         network use. This is the ONLY permission: the capture engine runs
         on "Notification access" — a special app access the user flips in
         system settings, which triggers no install-time permission prompt
         (and no Play Protect fraud warning — the reason the optional SMS
         receiver was removed in v1.4.1). -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:theme="@style/Theme.PocketVeto"
        android:allowBackup="true"
        android:supportsRtl="true">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|keyboardHidden|screenLayout|smallestScreenSize|uiMode|density">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- The auto-detect engine: reads payment notifications from any
             app (PhonePe, GPay, Paytm, banks…). Special app access — the
             user flips the switch in system settings; nothing is captured
             before that, and it can be revoked any time. -->
        <service
            android:name=".PaymentListenerService"
            android:exported="true"
            android:label="@string/notif_listener_label">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
    </application>
</manifest>
