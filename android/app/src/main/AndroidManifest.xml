<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- The web layer is bundled locally; the virtual https origin still
         requires INTERNET for WebView bookkeeping. No telemetry, no other
         network use. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Optional payment-SMS capture: off until the user grants it at
         runtime from inside the app (Scan → Phone capture). -->
    <uses-permission android:name="android.permission.RECEIVE_SMS" />

    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:theme="@style/Theme.PocketVeto"
        android:allowBackup="true"
        android:supportsRtl="true">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|keyboardHidden|screenLayout|smallestScreenSize|uiMode|density">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- The auto-detect engine: reads payment notifications from any
             app (PhonePe, GPay, banks…). Special app access — the user
             flips the switch in system settings; nothing is captured
             before that. -->
        <service
            android:name=".PaymentListenerService"
            android:exported="true"
            android:label="@string/notif_listener_label">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <receiver
            android:name=".SmsReceiver"
            android:exported="true"
            android:permission="android.permission.BROADCAST_SMS">
            <intent-filter>
                <action android:name="android.provider.Telephony.SMS_RECEIVED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
